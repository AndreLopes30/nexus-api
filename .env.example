# Copy this file to .env for local development. Never commit real credentials.
DATABASE_URL=sqlite:///./nexus.db
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SQLALCHEMY_ECHO=false
LOG_LEVEL=INFO
CREATE_TABLES_ON_STARTUP=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
